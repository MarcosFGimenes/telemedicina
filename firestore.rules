rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, update, delete: if isOwner() || isAdmin();
      allow create: if request.auth != null && request.resource.data.authUid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }

  function isOwner() {
    return request.auth != null && resource.data.authUid == request.auth.uid;
  }

  function isAdmin() {
    return request.auth != null &&
      (request.auth.token.admin == true || request.auth.token.role == 'admin' || request.auth.token['custom:role'] == 'admin');
  }
}
